# Server Port
PORT=5005

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Optional TTS Provider Configuration
# Supported providers: browser (default), openai, elevenlabs
TTS_PROVIDER=browser

# Provider API Credentials (Optional - leave empty for browser speech synthesis)
TTS_API_KEY=
TTS_ENDPOINT=
TTS_MODEL=
MAX_TEXT_LENGTH=5000
